# ----------------------------------------------------------------------------
# RS Athletics — Umgebungsvariablen
# Kopiere diese Datei zu ".env.local" und trage deine Supabase-Werte ein.
# (.env.local wird NICHT eingecheckt — siehe .gitignore)
# ----------------------------------------------------------------------------

# Öffentlich (landen im Browser-Bundle — das ist ok):
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# NUR serverseitig (NIEMALS mit NEXT_PUBLIC_ prefixen!):
# Wird für das Anlegen von Athleten/Coach (Supabase Admin-API) gebraucht.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Hinweis: Der Coach-Code wird NICHT hier gespeichert.
# Er ist das Passwort des Coach-Auth-Users (von Supabase gehasht abgelegt)
# und wird einmalig per `npm run create-coach` angelegt. Details im README.
